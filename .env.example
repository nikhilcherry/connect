# Copy to .env (./connect up does it for you). Everything is optional: without
# keys the backend and scan page still work; the n8n demo needs the two keys.
JEV_API_KEY=
OPENROUTER_API_KEY=
# Where the n8n violation dispatcher's demo emails go. Its Gmail step also needs a Gmail
# account connected in n8n (Credentials > Gmail account), or those emails fail.
DEMO_INBOX=
# Where the n8n whisper relay delivers when a request says "deliver": true. Default: this machine's backend.
N8N_CONNECT_API=

# Where the scan page tells browsers to find the API. Use your public address
# if phones are not on the same machine (needs the tunnel profile).
CONNECT_API_URL=http://localhost:54321

# Host ports, if the defaults are taken.
SCAN_PORT=8093
N8N_PORT=5678

# Optional: a Cloudflare tunnel token to publish the API and scan page.
TUNNEL_TOKEN=

# Every alert the backend creates is also sent (plate last 4, kind, note, language) to the n8n alert flow so
# you can watch it work. Set to an empty value (N8N_ALERT_WEBHOOK=) to switch it off.
# N8N_ALERT_WEBHOOK=http://host.docker.internal:5678/webhook/connect-alert
